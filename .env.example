# Bu dosya şablondur. Kopyala: .env  (commit edilmez). Gerçek değerleri sadece .env'ye yaz.

# OKX ATK — anahtar yok. Erişim `okx auth login` (OAuth, site tr). Bu hesap GERÇEK PARA.
# Emirler config.dry_run=false olmadan gönderilmez.
OKX_SITE=tr

# Avalanche Fuji (chain ID 43113)
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVAX_CHAIN_ID=43113
# Sadece bu proje için üretilmiş TEST cüzdanı. Ana cüzdan anahtarı ASLA.
# T-003'te chain rolü üretip buraya yazar; kullanıcıya sadece adresi söyler.
AGENT_PRIVATE_KEY=
