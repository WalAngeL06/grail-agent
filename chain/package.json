{
  "name": "grail-chain",
  "version": "1.0.0",
  "private": true,
  "description": "GRAIL ERC-8004 identity and immutable commit-reveal ledger",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "verify:fuji": "hardhat run scripts/verify-deployment.ts --network fuji",
    "verify:sources": "hardhat run scripts/check-source-verification.ts --network fuji",
    "verify:cycle": "hardhat run scripts/verify-cycle.ts --network fuji",
    "verify:cycle:1": "hardhat run scripts/verify-cycle.ts --network fuji --cycle 1 --commit-tx 0x7b47c4f313ffa5630d1acfff6411f11c6d13c321bbc69649ec8c90976995f728 --reveal-tx 0x541cb8ff88aac0248fbf79d7997915b62bb08fb873e226bbefc35cbcec77cf45",
    "deploy:local": "hardhat run scripts/deploy.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-verify": "2.0.14",
    "@openzeppelin/contracts": "5.0.2",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.1",
    "chai": "4.5.0",
    "dotenv": "17.2.3",
    "ethers": "6.15.0",
    "hardhat": "2.26.3",
    "solc": "0.8.20",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "keywords": [
    "erc8004",
    "ai-agent",
    "ethereum",
    "avalanche",
    "reputation",
    "identity",
    "web3"
  ],
  "license": "MIT"
}
